# WeatherGPT Environment Configuration
# Copy this file to .env and customize the values

# =============================================================================
# LLM Provider Chain (Three-tier fallback for resilience)
# =============================================================================

# Tier A: Primary (Groq - free, fast)
# Get API key from: https://console.groq.com
LLM_PRIMARY_BASE_URL=https://api.groq.com/openai/v1
LLM_PRIMARY_MODEL=openai/gpt-oss-20b
LLM_PRIMARY_API_KEY=your-groq-api-key-here

# Tier B: Secondary (Gemini - free, alternative)
# Get API key from: https://aistudio.google.com/app/apikey
LLM_SECONDARY_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_SECONDARY_MODEL=gemini-2.0-flash
LLM_SECONDARY_API_KEY=your-gemini-api-key-here

# Tier C: Fallback (Ollama - local, offline capable)
# Install: https://ollama.ai/ then run: ollama pull llama3.2:1b
# Optional - only needed for full offline demo
LLM_FALLBACK_BASE_URL=http://localhost:11434/v1
LLM_FALLBACK_MODEL=llama3.2:1b

# =============================================================================
# Database Configuration
# =============================================================================
DATABASE_URL=postgresql://weathergpt:weathergpt_password@postgres:5432/weathergpt
REDIS_URL=redis://redis:6379

# =============================================================================
# API Security
# =============================================================================
API_SECRET_KEY=your-super-secret-key-change-in-production
API_DEBUG=true

# =============================================================================
# Frontend Configuration
# =============================================================================
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# =============================================================================
# Optional: Weather Data Sources
# =============================================================================
# Open-Meteo is used by default (no key required)
# Additional sources can be configured here if needed

# =============================================================================
# Notes:
# 1. Get free API keys from Groq and Gemini (links above)
# 2. The system will fallback through tiers if one fails
# 3. At minimum, configure PRIMARY for basic functionality
# 4. Ollama (Tier C) is optional - only for offline demos
# 5. Never commit .env to git - use .env.example as template
# =============================================================================
