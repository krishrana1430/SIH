# WeatherGPT Environment Configuration

# LLM Provider Chain (Three-tier fallback for resilience)

# Tier A: Primary (Groq - free, fast)
LLM_PRIMARY_BASE_URL=https://api.groq.com/openai/v1
LLM_PRIMARY_MODEL=openai/gpt-oss-20b
LLM_PRIMARY_API_KEY=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

# Tier B: Secondary (Gemini - free, alternative)
LLM_SECONDARY_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_SECONDARY_MODEL=gemini-2.0-flash
LLM_SECONDARY_API_KEY=AQ.Ab8RN6LO-Sa3QGfNqKkABADdmvMRavBgSSKeYfxIEvXm1sAqww

# Tier C: Fallback (Ollama - local, offline capable)
# Optional - only needed for offline demos
LLM_FALLBACK_BASE_URL=http://localhost:11434/v1
LLM_FALLBACK_MODEL=llama3.2:1b

# Database Configuration (SQLite for development)
DATABASE_URL=sqlite:///./weathergpt.db
# DATABASE_URL=postgresql://weathergpt:weathergpt_password@postgres:5432/weathergpt
REDIS_URL=redis://redis:6379

# API Security
API_SECRET_KEY=weather-gpt-secret-key-2024

# Backend Configuration
API_DEBUG=true

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# =============================================================================
# SMS Alert Configuration (Optional - for stretch goal)
# =============================================================================
SMS_ENABLED=true
SMS_PROVIDER=mock  # twilio, aws_sns, webhook, mock

# Twilio Configuration (if using Twilio)
# Get credentials from: https://www.twilio.com/console
# TWILIO_ACCOUNT_SID=your-account-sid
# TWILIO_AUTH_TOKEN=your-auth-token
# TWILIO_PHONE_NUMBER=+1234567890

# AWS SNS Configuration (if using AWS SNS)
# AWS_REGION=ap-south-1
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key

# Custom Webhook Configuration (if using webhook)
# SMS_WEBHOOK_URL=https://your-webhook-url.com/sms
